# Generate a random token locally; configure it securely on the backend and in the iPhone app.
INSPECTION_API_TOKEN=
INSPECTION_DATA_DIR=/tmp/jbi-inspections
# Optional: analysis and semantic search. Manual workflows work without it.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Optional trusted local LibreOffice executable.
DSENY_OFFICE_BIN=
